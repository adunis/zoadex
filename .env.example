# === Database ===
POSTGRES_DB=zoadex
POSTGRES_USER=zoadex
POSTGRES_PASSWORD=zoadex

# === Backend (Spring Boot) ===
# JWT signing secret (min 32 characters, change in production!)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# Stripe (for premium plan checkout)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# File upload directory (inside container)
UPLOAD_DIR=/app/uploads

# === Frontend (build-time) ===
# API base URL (used during Vite build)
VITE_API_BASE_URL=http://localhost:8080/api/v1
